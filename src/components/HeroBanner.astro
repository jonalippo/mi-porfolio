---
import styles from './HeroBanner.module.css';
---

<section class={styles.heroBanner}>
    <div class={styles.contentHeroBanner}>
        <div class={styles.contentDescription}>
            <h1 class={styles.titleHeroBanner}>Hola! Soy</h1>
            <p class={styles.name}>Jonatan Lippo</p>
            <p class={styles.textDescription}>- Desarrollador Front-end & Mobile -</Desarrollador></p>
        </div>

        <div class={styles.imageContainer}>
            <img src="../../imgPerfil.png" alt="ImagenPerfil" class={styles.heroImage} />
        </div>
    </div>

    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" class={styles.arrowBounce} onclick="scrollToNextSection('hola')">
        <path fill="#1df3f7" d="M12 7v8.25L15.25 12l.75.66l-4.5 4.5l-4.5-4.5l.75-.66L11 15.25V7zm-.5 15C6.26 22 2 17.75 2 12.5A9.5 9.5 0 0 1 11.5 3a9.5 9.5 0 0 1 9.5 9.5a9.5 9.5 0 0 1-9.5 9.5m0-1a8.5 8.5 0 0 0 8.5-8.5A8.5 8.5 0 0 0 11.5 4A8.5 8.5 0 0 0 3 12.5a8.5 8.5 0 0 0 8.5 8.5"/>
    </svg>
</section>

<script is:inline>
    // La función recibe el ID del elemento al que queremos desplazarnos (ej. 'hola')
    function scrollToNextSection(id) { 
        const targetElement = document.getElementById(id);
        
        if (targetElement) {
            targetElement.scrollIntoView({
                behavior: 'smooth', // Desplazamiento animado y suave
                block: 'start'      // Alinea la parte superior del elemento con la parte superior del viewport
            });
        }
    }
</script>